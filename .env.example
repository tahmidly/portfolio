# ── Build-time (inlined into the site by Astro) ───────────────────────────────
# Public site URL used for canonical URLs, sitemap, RSS and JSON-LD
PUBLIC_SITE_URL=https://your-domain.com

# Optional GitHub username for the contribution graph
PUBLIC_GITHUB_USERNAME=

# ── Runtime secrets (Cloudflare Worker) ───────────────────────────────────────
# Locally: put them in .env.local (or .dev.vars). In production:
#   npx wrangler secret put DATABASE_URL   (and ADMIN_PASSWORD, AUTH_SECRET)

# Neon Postgres connection string (use the *pooled* "-pooler" host)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Admin studio login. Single owner, password only.
# Use a long random value: node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie (32+ random bytes).
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
