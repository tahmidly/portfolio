---
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.jsx";
import { DEFAULT_OG_IMAGE, SITE_URL, absoluteUrl } from "../lib/site";
import "../styles/tailwind.css";
import "../styles/base.css";

const DEFAULT_TITLE = "Meer Tahmid";
const DEFAULT_DESCRIPTION =
  "Frontend developer crafting responsive web applications with modern React and JavaScript technologies.";

const {
  title,
  description = DEFAULT_DESCRIPTION,
  canonical,
  noindex = false,
  og = {},
  twitter,
  jsonLd,
  rss = false,
} = Astro.props;

const fullTitle = title ? `${title} — Meer Tahmid` : DEFAULT_TITLE;
const canonicalUrl = canonical ? absoluteUrl(canonical) : undefined;
const pathname = Astro.url.pathname;
const ogTitle = og.title ?? title ?? DEFAULT_TITLE;
const ogDescription = og.description ?? description;
// Pages without their own image (home, works, blogs) share the logo mark.
const hasOwnImage = Boolean(og.images?.length);
const ogImages = hasOwnImage
  ? og.images
  : [{ ...DEFAULT_OG_IMAGE, url: absoluteUrl(DEFAULT_OG_IMAGE.url) }];
// transition:animate="none" on <html>: no crossfade, pages swap instantly.
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    {
      rss ? (
        <link
          rel="alternate"
          type="application/rss+xml"
          title="Meer Tahmid — Journal"
          href={absoluteUrl("/blogs/rss.xml")}
        />
      ) : null
    }

    {
      !noindex ? (
        <>
          <meta property="og:title" content={ogTitle} />
          <meta property="og:description" content={ogDescription} />
          <meta property="og:type" content={og.type ?? "website"} />
          <meta property="og:url" content={canonicalUrl ?? SITE_URL} />
          <meta property="og:site_name" content="Meer Tahmid" />
          {og.publishedTime ? (
            <meta property="article:published_time" content={og.publishedTime} />
          ) : null}
          {og.modifiedTime ? (
            <meta property="article:modified_time" content={og.modifiedTime} />
          ) : null}
          {ogImages.map((image) => (
            <>
              <meta property="og:image" content={image.url} />
              {image.alt ? <meta property="og:image:alt" content={image.alt} /> : null}
              {image.width ? <meta property="og:image:width" content={String(image.width)} /> : null}
              {image.height ? <meta property="og:image:height" content={String(image.height)} /> : null}
            </>
          ))}
          <meta
            name="twitter:card"
            content={twitter?.card ?? (hasOwnImage ? "summary_large_image" : "summary")}
          />
          <meta name="twitter:title" content={ogTitle} />
          <meta name="twitter:description" content={ogDescription} />
          {ogImages[0] ? <meta name="twitter:image" content={ogImages[0].url} /> : null}
        </>
      ) : null
    }

    <link rel="icon" type="image/png" href="/logo-mark.png" />
    <link rel="preload" href="/logo-mark.png" as="image" fetchpriority="high" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Questrial&display=swap"
      rel="stylesheet"
    />

    {
      jsonLd ? (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
        />
      ) : null
    }

    <!--
      Runs before first paint and after every client-side page swap (the swap
      replaces <html> attributes):
      - re-applies the blog light theme so post pages never flash dark
      - marks the intro loader as already shown, so returning home skips it
    -->
    <script is:inline>
      (function () {
        if (window.__mtHead) return;
        window.__mtHead = true;
        function apply() {
          var root = document.documentElement;
          var path = location.pathname;
          var themed = path.indexOf("/blogs/") === 0;
          var light = false;
          try {
            light = themed && localStorage.getItem("blog-theme") === "light";
          } catch (e) {}
          root.classList.toggle("light", light);
          if (window.__mtBooted) root.classList.add("booted");
        }
        apply();
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <Navbar client:load pathname={pathname} transition:persist="navbar" />
    <slot />
  </body>
</html>
