---
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.jsx";
import Footer from "../components/Footer.astro";
import { DEFAULT_OG_IMAGE, SITE_URL, absoluteUrl, pageUrl } from "../lib/site";
import "../styles/tailwind.css";
import "../styles/base.css";

const DEFAULT_TITLE = "Meer Tahmid";
// Used in search results and link previews when a page has no description.
const DEFAULT_DESCRIPTION =
  "The personal space of Meer Tahmid, a software engineer from Bangladesh: my work, my stories and the small moments I notice along the way.";

const {
  title,
  description = DEFAULT_DESCRIPTION,
  canonical,
  noindex = false,
  og = {},
  twitter,
  jsonLd,
  rss = false,
  // bare: no navbar or footer (e.g. a single photo filling the screen).
  bare = false,
} = Astro.props;

const fullTitle = title ? `${title} — Meer Tahmid` : DEFAULT_TITLE;
const canonicalUrl = canonical ? pageUrl(canonical) : undefined;
const pathname = Astro.url.pathname;
const ogTitle = og.title ?? title ?? DEFAULT_TITLE;
const ogDescription = og.description ?? description;
// Pages without their own image (home, works, blogs) share the logo mark.
// A page can pass og.images (a list) or og.image (one URL).
const ownImages = og.images?.length
  ? og.images
  : og.image
    ? [{ url: absoluteUrl(og.image), alt: og.imageAlt }]
    : [];
const hasOwnImage = ownImages.length > 0;
const ogImages = hasOwnImage
  ? ownImages
  : [{ ...DEFAULT_OG_IMAGE, url: absoluteUrl(DEFAULT_OG_IMAGE.url) }];
---

<!doctype html>
<!-- The public site is light only (the "light" theme tokens in base.css). -->
<html lang="en" class="light" transition:animate="fade">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    {
      rss ? (
        <link
          rel="alternate"
          type="application/rss+xml"
          title="Meer Tahmid — Journal"
          href={absoluteUrl("/blogs/rss.xml")}
        />
      ) : null
    }

    {
      !noindex ? (
        <>
          <meta property="og:title" content={ogTitle} />
          <meta property="og:description" content={ogDescription} />
          <meta property="og:type" content={og.type ?? "website"} />
          <meta property="og:url" content={canonicalUrl ?? SITE_URL} />
          <meta property="og:site_name" content="Meer Tahmid" />
          {og.publishedTime ? (
            <meta property="article:published_time" content={og.publishedTime} />
          ) : null}
          {og.modifiedTime ? (
            <meta property="article:modified_time" content={og.modifiedTime} />
          ) : null}
          {ogImages.map((image) => (
            <>
              <meta property="og:image" content={image.url} />
              {image.alt ? <meta property="og:image:alt" content={image.alt} /> : null}
              {image.width ? <meta property="og:image:width" content={String(image.width)} /> : null}
              {image.height ? <meta property="og:image:height" content={String(image.height)} /> : null}
            </>
          ))}
          <meta
            name="twitter:card"
            content={twitter?.card ?? (hasOwnImage ? "summary_large_image" : "summary")}
          />
          <meta name="twitter:title" content={ogTitle} />
          <meta name="twitter:description" content={ogDescription} />
          {ogImages[0] ? <meta name="twitter:image" content={ogImages[0].url} /> : null}
        </>
      ) : null
    }

    <link rel="icon" type="image/png" href="/logom-small.png" />
    <link rel="preload" href="/logom-small.png" as="image" fetchpriority="high" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Questrial&display=swap"
      rel="stylesheet"
    />

    {
      jsonLd ? (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
        />
      ) : null
    }

    <ClientRouter />
  </head>
  <body>
    {!bare && <Navbar client:load pathname={pathname} transition:persist="navbar" />}
    <slot />
    {!bare && <Footer />}
  </body>
</html>
