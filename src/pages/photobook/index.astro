---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { moments, logDate } from "../../data/moments";

// Moments as an old book lying open on a wooden table: two pages per spread,
// two dated entries per page, each with a small "pasted-in" photograph and a
// note. Pages turn with a 3D flip (buttons, arrow keys or a swipe).
// Two entries per page; an even number of pages so every spread is full
// (an extra closing page is added when needed).
const pages = [];
for (let i = 0; i < moments.length; i += 2) pages.push(moments.slice(i, i + 2));
if (pages.length % 2 === 1) pages.push([]);
const spreads = pages.length / 2;
const year = moments[0] ? new Date(`${moments[0].date}T12:00:00`).getFullYear() : "";

// Ragged, torn outer edges for each page (the spine side stays straight).
// A small seeded random keeps every page different but stable between builds.
function seeded(seed) {
  let t = seed * 9301 + 49297;
  return () => {
    t = (t * 9301 + 49297) % 233280;
    return t / 233280;
  };
}
function tornEdge(index) {
  const rand = seeded(index + 7);
  const left = index % 2 === 0;
  const jitterY = () => (rand() * 1.6).toFixed(2); // up to ~9px top/bottom
  const jitterX = () => (rand() * 1.4).toFixed(2); // up to ~9px at the sides
  const steps = 60;
  const pts = [];
  if (left) {
    // top: right to left, left edge: top to bottom, bottom: left to right
    for (let i = 0; i <= steps; i++) pts.push(`${100 - (i / steps) * 100}% ${jitterY()}%`);
    for (let i = 1; i < steps; i++) pts.push(`${jitterX()}% ${(i / steps) * 100}%`);
    for (let i = 0; i <= steps; i++) pts.push(`${(i / steps) * 100}% ${100 - jitterY()}%`);
  } else {
    // top: left to right (ending in a folded corner), right edge, bottom: right to left
    for (let i = 0; i < steps; i++) pts.push(`${(i / steps) * 100 * 0.94}% ${jitterY()}%`);
    pts.push("calc(100% - 34px) 0%", "100% 34px");
    for (let i = 2; i < steps; i++) pts.push(`${100 - jitterX()}% ${(i / steps) * 100}%`);
    for (let i = 0; i <= steps; i++) pts.push(`${100 - (i / steps) * 100}% ${100 - jitterY()}%`);
  }
  return `clip-path: polygon(${pts.join(", ")});`;
}

// Weathered wooden planks for the table (free photo from Unsplash).
const TABLE =
  "https://images.unsplash.com/photo-1546484396-fb3fc6f95f98?w=2000&q=70&auto=format&fit=crop";

const description = "Small moments and photographs, kept like an old logbook.";
---

<BaseLayout
  title="Photobook"
  description={description}
  canonical="/photobook"
  og={{ title: "Photobook — Meer Tahmid", description }}
  bare
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&display=swap"
  />

  <main class="mo">
    <h1 class="sr-only">Photobook — a book of small moments</h1>

    <section class="table" data-table style={`--table-image: url("${TABLE}")`}>
      <a href="/" class="home-btn" aria-label="Back to the home page">← Home</a>
      <button type="button" class="full-btn" data-full aria-label="Fullscreen" title="Fullscreen">
        <svg class="full-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
        <svg class="full-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" /></svg>
      </button>
      <div class="book" data-book>
        <div class="book-stage" data-stage tabindex="0" aria-label="Photobook. Use the arrow keys to turn pages.">
          {pages.map((entries, index) => (
            <section
              class={`page ${index % 2 === 0 ? "page--left" : "page--right"}${index % 4 === 1 || index % 4 === 2 ? " page--alt" : ""}`}
              style={tornEdge(index)}
              data-page
            >
              <p class="page-running">
                {index % 2 === 0 ? (
                  <span>From Bangladesh, onwards.</span>
                ) : (
                  <span>In the photobook, {year}.</span>
                )}
              </p>

              {entries.length === 0 ? (
                <p class="page-blank">The rest of this book is still blank.</p>
              ) : null}

              {entries.map((moment) => (
                <article class="entry">
                  <header class="entry-head">
                    <span class="entry-day">{logDate(moment.date)}</span>
                    <span class="entry-place">{moment.place}</span>
                  </header>
                  <div class="entry-body">
                    <a class="entry-photo" href={`/photobook/${moment.slug}/`} aria-label={`Open “${moment.title}”`}>
                      <img src={moment.image} alt={moment.alt} loading="lazy" decoding="async" draggable="false" />
                      {moment.images.length > 1 && (
                        <span class="entry-count">{moment.images.length} photos</span>
                      )}
                    </a>
                    <div class="entry-text">
                      <h2 class="entry-title">{moment.title}</h2>
                      <p class="entry-note">{moment.note}</p>
                      <p class="entry-weather">Weather — {moment.weather}</p>
                    </div>
                  </div>
                </article>
              ))}

              <p class="page-number">{index + 1}</p>
            </section>
          ))}
          <p class="page-blank" data-blank hidden>The rest of this book is still blank.</p>
        </div>
      </div>

      <nav class="book-nav" aria-label="Turn pages">
        <button type="button" class="book-btn" data-prev aria-label="Previous page">
          ← Previous
        </button>
        <span class="book-count" data-count aria-live="polite">1 of {spreads}</span>
        <button type="button" class="book-btn" data-next aria-label="Next page">
          Next →
        </button>
      </nav>
    </section>
  </main>
</BaseLayout>

<script>
  // Page turning with a 3D flip.
  // Desktop shows a spread (two pages): "next" lifts the right page and turns
  // it over the spine; "previous" turns the left page back. Phones show one
  // page and turn it like a single leaf. Buttons, arrow keys and swipes work.
  const DURATION = 560; // ms for one page turn

  function initBook() {
    const book = document.querySelector("[data-book]");
    if (!book || book.dataset.ready) return;
    book.dataset.ready = "1";

    const stage = book.querySelector("[data-stage]");
    let pages = [...stage.querySelectorAll("[data-page]")];
    const prevBtn = document.querySelector("[data-prev]");
    const nextBtn = document.querySelector("[data-next]");
    const count = document.querySelector("[data-count]");
    const desktopQuery = window.matchMedia("(min-width: 861px)");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    let desktop = desktopQuery.matches;
    let index = 0; // spread on desktop, page on phones
    let busy = false;
    let goal = 0; // where the book will end up once queued turns finish
    let finishTurn = null; // ends the page that is turning right now

    const total = () => (desktop ? pages.length / 2 : pages.length);
    const slots = ["slot-left", "slot-right", "slot-single"];

    // Counter and buttons — updated the moment a turn starts.
    function updateControls(at) {
      count.textContent = `${at + 1} of ${total()}`;
      prevBtn.disabled = at <= 0;
      nextBtn.disabled = at >= total() - 1;
    }

    function show() {
      pages.forEach((page) => page.classList.remove(...slots));
      if (desktop) {
        pages[index * 2]?.classList.add("slot-left");
        pages[index * 2 + 1]?.classList.add("slot-right");
      } else {
        pages[index]?.classList.add("slot-single");
      }
      updateControls(goal);
    }

    // ─── Fitting moments to the page ───
    // Each page takes as many moments as fit its height (at most 3; always 1
    // on phones). Tall screens get 3 per page, short or zoomed-in ones 1.
    // The server-rendered pages are reused as templates so their styles apply.
    const MAX_PER_PAGE = 3;
    const phoneQuery = window.matchMedia("(max-width: 640px)");
    const entries = [...stage.querySelectorAll(".entry")];
    const blankTpl = stage.querySelector("[data-blank]");
    const templates = [pages[0], pages[1]].map((page) => {
      const tpl = page.cloneNode(true);
      tpl.querySelectorAll(".entry, .page-blank").forEach((el) => el.remove());
      tpl.classList.remove(...slots);
      return tpl;
    });
    let entryPage = entries.map((_, i) => Math.floor(i / 2)); // entry → page

    // Ragged edges, as in the server-rendered pages (the spine side stays straight).
    function tornEdge(i) {
      let t = (i + 7) * 9301 + 49297;
      const rand = () => (t = (t * 9301 + 49297) % 233280) / 233280;
      const jy = () => (rand() * 1.6).toFixed(2);
      const jx = () => (rand() * 1.4).toFixed(2);
      const steps = 60;
      const pts = [];
      if (i % 2 === 0) {
        for (let k = 0; k <= steps; k++) pts.push(`${100 - (k / steps) * 100}% ${jy()}%`);
        for (let k = 1; k < steps; k++) pts.push(`${jx()}% ${(k / steps) * 100}%`);
        for (let k = 0; k <= steps; k++) pts.push(`${(k / steps) * 100}% ${100 - jy()}%`);
      } else {
        for (let k = 0; k < steps; k++) pts.push(`${(k / steps) * 100 * 0.94}% ${jy()}%`);
        pts.push("calc(100% - 34px) 0%", "100% 34px");
        for (let k = 2; k < steps; k++) pts.push(`${100 - jx()}% ${(k / steps) * 100}%`);
        for (let k = 0; k <= steps; k++) pts.push(`${100 - (k / steps) * 100}% ${100 - jy()}%`);
      }
      return `polygon(${pts.join(", ")})`;
    }

    function newPage(i) {
      const page = templates[i % 2].cloneNode(true);
      page.className = `page ${i % 2 ? "page--right" : "page--left"}${i % 4 === 1 || i % 4 === 2 ? " page--alt" : ""}`;
      page.style.clipPath = tornEdge(i);
      page.querySelector(".page-number").textContent = i + 1;
      // Measured where it will be shown, so the width is right.
      page.classList.add(desktop ? "slot-left" : "slot-single");
      stage.appendChild(page);
      return page;
    }

    const overflows = (page) => page.scrollHeight > page.clientHeight + 1;

    function paginate() {
      const max = phoneQuery.matches ? 1 : MAX_PER_PAGE;
      pages.forEach((page) => page.remove());
      pages = [];
      entryPage = [];
      let page = null;
      let onPage = 0;
      const start = () => {
        page = newPage(pages.length);
        pages.push(page);
        onPage = 0;
      };
      start();
      entries.forEach((entry, i) => {
        if (onPage >= max) start();
        const number = page.querySelector(".page-number");
        page.insertBefore(entry, number);
        // Didn't fit: move it to a fresh page (a lone moment always stays).
        if (onPage > 0 && overflows(page)) {
          start();
          page.insertBefore(entry, page.querySelector(".page-number"));
        }
        onPage++;
        entryPage[i] = pages.length - 1;
      });
      // Spreads need an even number of pages: close with a blank one.
      if (desktop && pages.length % 2) {
        start();
        const blank = blankTpl.cloneNode(true);
        blank.hidden = false;
        blank.removeAttribute("data-blank");
        page.insertBefore(blank, page.querySelector(".page-number"));
      }
      pages.forEach((p) => {
        p.classList.remove(...slots);
        p.dataset.page = "";
      });
    }

    // Re-fit after a resize or zoom, staying on the same moment.
    function refit() {
      if (busy) return;
      const firstPage = desktop ? index * 2 : index;
      const keep = Math.max(0, entryPage.indexOf(firstPage));
      desktop = desktopQuery.matches;
      paginate();
      const page = entryPage[keep] ?? 0;
      index = Math.min(desktop ? Math.floor(page / 2) : page, total() - 1);
      goal = index;
      show();
    }

    // A copy of a page used as one face of the turning leaf.
    function face(page, back) {
      const wrap = document.createElement("div");
      wrap.className = `leaf-face${back ? " leaf-back" : ""}`;
      if (page) {
        const copy = page.cloneNode(true);
        copy.classList.remove(...slots);
        copy.removeAttribute("data-page");
        copy.querySelectorAll("img").forEach((img) => (img.loading = "eager"));
        wrap.appendChild(copy);
      } else {
        wrap.classList.add("leaf-plain");
      }
      const shade = document.createElement("span");
      shade.className = "leaf-shade";
      wrap.appendChild(shade);
      return wrap;
    }

    // Build a leaf, run the turn, then clean up.
    function turn({ side, front, back, from, to, target, done }) {
      const leaf = document.createElement("div");
      leaf.className = `leaf leaf--${side}`;
      leaf.style.transform = from;
      leaf.append(face(front, false), face(back, true));
      stage.appendChild(leaf);
      // Read layout once so the starting angle is applied, then turn.
      void leaf.offsetWidth;
      // More clicks waiting: turn faster so the book keeps up.
      const ms = goal !== target ? DURATION * 0.6 : DURATION;
      leaf.style.setProperty("--turn", `${ms}ms`);
      leaf.classList.add("is-turning");
      leaf.style.transform = to;
      const finish = () => {
        if (!leaf.isConnected) return;
        finishTurn = null;
        leaf.remove();
        done();
        busy = false;
        advance();
      };
      leaf.addEventListener("transitionend", (e) => e.target === leaf && finish());
      setTimeout(() => leaf.isConnected && finish(), ms + 150);
      finishTurn = finish;
    }

    // Every click counts and answers at once: a click during a turn lands
    // the turning page straight away and starts the next turn, so the book
    // keeps up however fast you click. The counter shows the page you asked
    // for immediately.
    function go(step) {
      const from = busy ? goal : index;
      const next = Math.min(Math.max(from + step, 0), total() - 1);
      if (next === from) return;
      goal = next;
      updateControls(goal);
      if (busy) finishTurn?.(); // lands the current page, then turns the next
      else advance();
    }

    function advance() {
      if (busy || index === goal) return;
      turnOnce(goal > index ? 1 : -1);
    }

    function turnOnce(step) {
      const target = index + step;
      if (reduceMotion.matches) {
        index = target;
        show();
        advance();
        return;
      }
      busy = true;

      if (desktop) {
        const L = pages[index * 2];
        const R = pages[index * 2 + 1];
        if (step > 0) {
          const NL = pages[target * 2];
          const NR = pages[target * 2 + 1];
          // Under the turning leaf: the next spread's right page.
          R.classList.remove("slot-right");
          NR.classList.add("slot-right");
          turn({
            target,
            side: "right",
            front: R,
            back: NL,
            from: "rotateY(0deg)",
            to: "rotateY(-180deg)",
            done: () => {
              index = target;
              show();
            },
          });
        } else {
          const PL = pages[target * 2];
          const PR = pages[target * 2 + 1];
          // Under the turning leaf: the previous spread's left page.
          L.classList.remove("slot-left");
          PL.classList.add("slot-left");
          turn({
            target,
            side: "left",
            front: L,
            back: PR,
            from: "rotateY(0deg)",
            to: "rotateY(180deg)",
            done: () => {
              index = target;
              show();
            },
          });
        }
      } else {
        const current = pages[index];
        const other = pages[target];
        if (step > 0) {
          // The current page lifts away to the left, revealing the next one.
          current.classList.remove("slot-single");
          other.classList.add("slot-single");
          turn({
            target,
            side: "single",
            front: current,
            back: null,
            from: "rotateY(0deg)",
            to: "rotateY(-180deg)",
            done: () => {
              index = target;
              show();
            },
          });
        } else {
          // The previous page comes back over the current one.
          turn({
            target,
            side: "single",
            front: other,
            back: null,
            from: "rotateY(-180deg)",
            to: "rotateY(0deg)",
            done: () => {
              index = target;
              show();
            },
          });
        }
      }
    }

    // Fullscreen: the table fills the whole screen, hiding the header and footer.
    // Uses the browser's real fullscreen where it exists, and a fixed overlay
    // where it doesn't (e.g. iPhone Safari).
    const table = document.querySelector("[data-table]");
    const fullBtn = document.querySelector("[data-full]");
    function setFull(on) {
      table.classList.toggle("is-full", on);
      document.documentElement.classList.toggle("mo-full", on);
      const label = on ? "Exit fullscreen" : "Fullscreen";
      fullBtn.setAttribute("aria-label", label);
      fullBtn.title = label;
    }
    fullBtn.addEventListener("click", () => {
      const on = !table.classList.contains("is-full");
      if (on) {
        setFull(true);
        table.requestFullscreen?.().catch(() => {});
      } else {
        setFull(false);
        if (document.fullscreenElement) document.exitFullscreen?.();
      }
      stage.focus({ preventScroll: true });
    });
    // Leaving browser fullscreen (Esc) also leaves our fullscreen view.
    document.addEventListener("fullscreenchange", () => {
      if (!document.fullscreenElement && table.classList.contains("is-full")) setFull(false);
    });
    // Keyboard: ← / → turn pages anywhere on the page (no need to click the
    // book first); Esc leaves fullscreen.
    const onKey = (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey) return;
      if (event.key === "ArrowRight") {
        event.preventDefault();
        go(1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        go(-1);
      } else if (event.key === "Escape" && table.classList.contains("is-full")) {
        setFull(false);
      }
    };
    document.addEventListener("keydown", onKey);
    document.addEventListener(
      "astro:before-swap",
      () => {
        setFull(false);
        document.removeEventListener("keydown", onKey);
      },
      { once: true },
    );

    // Buttons react on press (not release) so turning feels instant; a
    // keyboard Enter/Space still works through "click".
    for (const [btn, step] of [[prevBtn, -1], [nextBtn, 1]]) {
      btn.addEventListener("pointerdown", (event) => {
        if (event.button !== 0) return;
        event.preventDefault(); // no focus delay or text selection
        go(step);
      });
      btn.addEventListener("click", (event) => {
        if (event.detail === 0) go(step); // keyboard activation only
      });
    }

    // Swipe left/right to turn.
    let swiped = false;
    const SWIPE = 28; // px of sideways movement that turns the page

    // Touch: decide the direction on the first few pixels of movement. A
    // sideways swipe is locked in (the page won't scroll up or down while you
    // turn); an up/down drag scrolls the page as usual.
    let touch = null;
    stage.addEventListener(
      "touchstart",
      (event) => {
        if (event.touches.length !== 1) return (touch = null);
        const t = event.touches[0];
        touch = { x: t.clientX, y: t.clientY, axis: null, turned: false };
        swiped = false;
      },
      { passive: true },
    );
    stage.addEventListener(
      "touchmove",
      (event) => {
        if (!touch) return;
        const t = event.touches[0];
        const dx = t.clientX - touch.x;
        const dy = t.clientY - touch.y;
        if (!touch.axis && Math.hypot(dx, dy) > 6) {
          touch.axis = Math.abs(dx) > Math.abs(dy) * 0.8 ? "x" : "y";
        }
        if (touch.axis !== "x") return;
        if (event.cancelable) event.preventDefault();
        // Turn as soon as the finger has moved far enough — no waiting for
        // it to lift. One turn per swipe.
        if (!touch.turned && Math.abs(dx) > SWIPE) {
          touch.turned = true;
          swiped = true;
          go(dx < 0 ? 1 : -1);
        }
      },
      { passive: false },
    );
    stage.addEventListener("touchend", () => (touch = null));
    stage.addEventListener("touchcancel", () => (touch = null));

    // Mouse: drag sideways to turn (text and photos are not selectable or
    // draggable in the book, so dragging doesn't highlight anything).
    let drag = null;
    stage.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "touch" || event.button !== 0) return;
      drag = { x: event.clientX, y: event.clientY };
      swiped = false;
    });
    stage.addEventListener("pointermove", (event) => {
      if (!drag) return;
      const dx = event.clientX - drag.x;
      const dy = event.clientY - drag.y;
      if (Math.abs(dx) > SWIPE && Math.abs(dx) > Math.abs(dy)) {
        drag = null; // one turn per drag, right away
        swiped = true;
        go(dx < 0 ? 1 : -1);
      }
    });
    const endDrag = () => (drag = null);
    stage.addEventListener("pointerup", endDrag);
    stage.addEventListener("pointerleave", endDrag);
    stage.addEventListener("dragstart", (event) => event.preventDefault());
    // A swipe that ends on a photo turns the page instead of opening it.
    stage.addEventListener(
      "click",
      (event) => {
        if (swiped) {
          event.preventDefault();
          swiped = false;
        }
      },
      true,
    );

    // Resizing, zooming, fullscreen or switching between spread and single
    // page re-fits the moments and keeps your place.
    let resizeTimer = 0;
    const onResize = () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(refit, 150);
    };
    window.addEventListener("resize", onResize);
    // Also when the layout switches (phone / one page / spread) without a resize event.
    desktopQuery.addEventListener("change", onResize);
    phoneQuery.addEventListener("change", onResize);
    document.addEventListener("astro:before-swap", () => window.removeEventListener("resize", onResize), {
      once: true,
    });
    // The old-style font changes line heights once it has loaded.
    document.fonts?.ready.then(refit);

    paginate();

    // Coming back from a single moment (/photobook#m-3) opens the book on its page.
    const fromHash = /^#m-(\d+)$/.exec(location.hash);
    if (fromHash) {
      const page = entryPage[Number(fromHash[1])] ?? 0;
      index = Math.min(desktop ? Math.floor(page / 2) : page, total() - 1);
      goal = index;
    }

    show();
  }

  document.addEventListener("astro:page-load", initBook);
</script>

<style>
  .mo {
    /* No header or footer here: the table fills the whole screen. */
    --nav-h: 0px;
    --controls-h: 72px;
    padding-top: var(--nav-h);
    background: var(--bg);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ─── The wooden table: fills the screen under the navbar ─── */
  .table {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100svh - var(--nav-h));
    padding: 2rem 1.5rem 0;
    background:
      radial-gradient(ellipse at 50% 45%, rgba(0, 0, 0, 0) 30%, rgba(15, 8, 3, 0.55) 100%),
      linear-gradient(rgba(60, 35, 15, 0.15), rgba(60, 35, 15, 0.15)),
      var(--table-image) center / cover no-repeat,
      #3a2a1e;
  }

  /* ─── Fullscreen: the table covers the screen, header and footer hidden ─── */
  .table {
    position: relative;
  }
  .full-btn {
    position: absolute;
    top: 1.1rem;
    right: 1.25rem;
    z-index: 6;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid rgba(255, 240, 215, 0.35);
    border-radius: 9999px;
    background: rgba(245, 235, 215, 0.92);
    color: #2d2d2d;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  /* Way back to the rest of the site (top left, across from fullscreen). */
  .home-btn {
    position: absolute;
    top: 1.1rem;
