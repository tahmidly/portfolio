---
import BaseLayout from "../layouts/BaseLayout.astro";

// A real 404 (status 404), not a redirect — redirecting missing pages to the
// home page is treated as a "soft 404" by Google.
const places = [
  { href: "/", name: "Home", desc: "Start again from the beginning." },
  { href: "/works", name: "Works", desc: "Projects I've built, newest first." },
  { href: "/blogs", name: "Writing", desc: "Notes on life and things I'm learning." },
];
---

<BaseLayout title="Page not found" noindex>
  <main class="nf">
    <div class="nf-inner">
      <p class="nf-label">Error 404</p>
      <h1 class="nf-title">This page wandered off.</h1>
      <p class="nf-text">
        The link may be old, or the page may have moved. Here are a few places
        to go instead.
      </p>

      <ul class="nf-list">
        {
          places.map((place) => (
            <li>
              <a href={place.href}>
                <span class="nf-name">{place.name}</span>
                <span class="nf-desc">{place.desc}</span>
                <svg
                  class="nf-arrow"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                  <path d="m13 6 6 6-6 6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
</BaseLayout>

<style>
  .nf {
    min-height: 100svh;
    padding: calc(100px + 72px) 0 7.5rem;
    background: var(--bg);
  }
  .nf-inner {
    max-width: calc(760px + var(--container-pad) * 2);
    margin: 0 auto;
    padding: 0 var(--container-pad);
  }

  .nf-label {
    margin: 0 0 1rem;
    font-family: var(--font-label);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .nf-title {
    margin: 0 0 1.25rem;
    font-family: var(--font-heading);
    font-size: 56px;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--text);
  }
  .nf-text {
    max-width: 560px;
    margin: 0 0 3rem;
    font-family: var(--font-text);
    font-size: 19px;
    line-height: 32px;
    color: var(--muted);
  }

  /* Places to go: a line on top, then lines between items. */
  .nf-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--stroke);
  }
  .nf-list li + li {
    border-top: 1px solid var(--stroke);
  }
  .nf-list a {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr) 24px;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.4rem 0;
    color: inherit;
    text-decoration: none;
  }
  .nf-name {
    font-family: var(--font-heading);
    font-size: 24px;
    letter-spacing: -0.02em;
    color: var(--text);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nf-desc {
    font-family: var(--font-text);
    font-size: 16px;
    color: var(--muted);
  }
  .nf-arrow {
    align-self: center;
    justify-self: end;
    color: var(--text);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nf-list a:hover .nf-name {
    transform: translateX(6px);
  }
  .nf-list a:hover .nf-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .nf {
      padding: calc(64px + 3rem) 0 5rem;
    }
    .nf-inner {
      padding: 0 1rem;
    }
    .nf-title {
      font-size: 40px;
    }
    .nf-text {
      font-size: 17px;
      line-height: 29px;
    }
    .nf-list a {
      grid-template-columns: minmax(0, 1fr) 20px;
      gap: 0.3rem 1rem;
    }
    .nf-name {
      grid-column: 1;
    }
    .nf-desc {
      grid-column: 1;
      grid-row: 2;
    }
    .nf-arrow {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
