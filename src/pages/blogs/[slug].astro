---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPostPage from "../../views/BlogPostPage.jsx";
import NotFoundPage from "../../views/NotFoundPage.jsx";
import BlogThemeToggle from "../../components/BlogThemeToggle.jsx";
import {
  getPublishedPostBySlug,
  getPublishedPosts,
  getRedirectedSlug,
} from "../../lib/posts";
import { AUTHOR, SITE_URL, absoluteUrl } from "../../lib/site";

const { slug } = Astro.params;
const post = await getPublishedPostBySlug(slug);

let previous = null;
let next = null;
let jsonLd;
let og;

if (!post) {
  // Old slugs of renamed posts permanently redirect to the current URL.
  const current = await getRedirectedSlug(slug);
  if (current) return Astro.redirect(`/blogs/${current}`, 308);
  Astro.response.status = 404;
} else {
  // Published posts are newest-first: "previous" = older, "next" = newer.
  const all = await getPublishedPosts();
  const index = all.findIndex((item) => item.id === post.id);
  previous = index >= 0 ? all[index + 1] || null : null;
  next = index > 0 ? all[index - 1] : null;

  const url = `${SITE_URL}/blogs/${post.slug}`;
  jsonLd = [
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: post.title,
      description: post.seoDescription || post.excerpt,
      image: post.coverUrl ? [absoluteUrl(post.coverUrl)] : undefined,
      datePublished: post.publishedAt,
      dateModified: post.updatedAt,
      author: { "@type": "Person", name: AUTHOR, url: SITE_URL },
      publisher: { "@type": "Person", name: AUTHOR, url: SITE_URL },
      mainEntityOfPage: { "@type": "WebPage", "@id": url },
      url,
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL },
        { "@type": "ListItem", position: 2, name: "Blogs", item: `${SITE_URL}/blogs` },
        { "@type": "ListItem", position: 3, name: post.title, item: url },
      ],
    },
  ];

  og = {
    type: "article",
    publishedTime: post.publishedAt,
    modifiedTime: post.updatedAt,
    images: post.coverUrl
      ? [
          {
            url: absoluteUrl(post.coverUrl),
            alt: post.coverAlt || post.title,
            width: post.coverWidth || undefined,
            height: post.coverHeight || undefined,
          },
        ]
      : [],
  };
}
---

{
  post ? (
    <BaseLayout
      title={post.seoTitle || post.title}
      description={post.seoDescription || post.excerpt}
      canonical={`/blogs/${post.slug}`}
      og={og}
      jsonLd={jsonLd}
    >
      <BlogPostPage post={post} previous={previous} next={next} />
      <BlogThemeToggle client:load />
    </BaseLayout>
  ) : (
    <BaseLayout title="Page not found" noindex>
      <NotFoundPage />
    </BaseLayout>
  )
}
