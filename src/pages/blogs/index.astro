---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RecentWriting from "../../components/RecentWriting.jsx";
import { getPublishedPosts, toListPost } from "../../lib/blog";

// Every published post from src/content/blog/, newest first — the same
// classic list as the homepage's Recent writing.
const posts = (await getPublishedPosts()).map(toListPost);
const description =
  "Notes on life, things I'm learning and small moments, newest first.";
---

<BaseLayout
  title="Blogs"
  description={description}
  canonical="/blogs"
  og={{ title: "Blogs — Meer Tahmid", description }}
  rss
>
  <main class="list-page">
    <RecentWriting
      posts={posts}
      id="all-writing"
      label="Writing"
      title="All writing"
      sub="Notes on life, things I'm learning and small moments, newest first."
      headingAs="h1"
      allHref={null}
    />
  </main>
</BaseLayout>

<style>
  /* Room for the navbar above the section header. */
  .list-page {
    min-height: 100svh;
    padding-top: 100px;
    background: var(--bg);
  }
  @media (max-width: 640px) {
    .list-page {
      padding-top: 64px;
    }
  }
</style>
