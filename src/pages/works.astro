---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorksIndex from "../components/WorksIndex.jsx";
import { getPublishedWorks } from "../lib/works";

// Every published project from src/content/works/, newest first, as a
// two-column catalogue (name and facts | description and highlights).
const works = await getPublishedWorks();
const description =
  "Every project I've built, newest first — from idea to something people use.";
---

<BaseLayout
  title="Works"
  description={description}
  canonical="/works"
  og={{ title: "Works — Meer Tahmid", description }}
>
  <main class="list-page">
    <WorksIndex works={works} />
  </main>
</BaseLayout>

<style>
  /* Room for the navbar above the section header. */
  .list-page {
    min-height: 100svh;
    padding-top: 100px;
    background: var(--bg);
  }
  @media (max-width: 640px) {
    .list-page {
      padding-top: 64px;
    }
  }
</style>
