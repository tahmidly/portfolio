---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.jsx";
import FeaturedWorks from "../components/FeaturedWorks.jsx";
import SelectedWorks from "../components/SelectedWorks.jsx";
import Journal from "../components/Journal.jsx";
import Explorations from "../components/Explorations.jsx";
import TechStack from "../components/TechStack.jsx";
import Stats from "../components/Stats.jsx";
import Contact from "../components/Contact.jsx";
import { placeholderFor } from "../components/CoverImage.jsx";
import { formatPostDate, getPublishedPosts } from "../lib/blog";
import { AUTHOR, SITE_URL, absoluteUrl } from "../lib/site";
import { socialLinks } from "../data/portfolio";
import { getFeaturedWorks } from "../lib/works";

// The 3 projects picked in the studio ("Home featured"), in grid order.
const featuredWorks = await getFeaturedWorks();

// Latest 4 posts from src/content/blog/ for the Journal section.
const posts = await getPublishedPosts();
const entries = posts.slice(0, 4).map((post) => ({
  id: post.slug,
  title: post.title,
  readTime: post.readingTime,
  date: formatPostDate(post.publishedAt),
  image: post.coverUrl,
  alt: post.coverAlt,
  placeholder: placeholderFor(post.slug),
}));

// Structured data so Google knows who the site belongs to (name, links).
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: AUTHOR,
    url: SITE_URL,
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: AUTHOR,
    url: SITE_URL,
    image: absoluteUrl("/logo-mark.png"),
    jobTitle: "Frontend Developer",
    sameAs: socialLinks.map((link) => link.url),
  },
];
---

<BaseLayout canonical="/" jsonLd={jsonLd}>
  <main>
    <Hero />
    <FeaturedWorks works={featuredWorks} />
    {/* Other sections are turned off for now while the page is redesigned.
    <SelectedWorks client:load works={featuredWorks} />
    <Journal client:load entries={entries} />
    <Explorations client:load />
    <TechStack />
    <Stats client:load />
    <Contact client:load />
    */}
  </main>
</BaseLayout>
