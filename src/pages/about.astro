---
import BaseLayout from "../layouts/BaseLayout.astro";

// ─── Edit these to make the page yours ───
// Where I work now and before (linked in the opening paragraph, same as the homepage).
const WORK_NOW = { name: "Ideeza", url: "https://www.ideeza.com/" };
const WORK_BEFORE = { name: "Visiontillion", url: "https://www.visiontillion.com/en" };
// My story, one paragraph per item, in my own words. Write a link as
// [text](https://…) and it becomes a link on the page.
const STORY = [
  "I'm from Bangladesh.",
  "My first computer was my father's laptop. It was 2018, and I spent hours just figuring out how everything worked.",
  "Around that time, I watched my brother, [Meer Estiyak](https://mmestiyak.com/), building things on the web, and I wanted to do the same. In 2020, when I was ten, I started learning HTML on that same laptop.",
  "It wasn't easy. There was no Wi-Fi in our area, so getting online at all was a struggle. My brother was usually away from home for his work and studies, so most of the time I was on my own, figuring things out by myself.",
  "For a while, I drifted toward design. I learned Photoshop and Illustrator and spent my time playing with shapes, colors and layouts. I didn't know it then, but that taught me how things should look and feel, something I still use every day.",
  "In 2021, I came back to programming, this time for real. My brother guided me along the way, pointing me in the right direction whenever I got stuck, and seeing his work kept me inspired. From 2021 to 2025, I kept learning, building and breaking things.",
  "In 2025, I joined [Visiontillion](https://www.visiontillion.com/en), a 3D marketplace, where I spent eight months building the platform's foundation from scratch. It was my first real job, and the first time my code was used by real people.",
  "Now, in 2026, I'm at [Ideeza](https://www.ideeza.com/), working on browser-based CAD tools, 2D and 3D editors and a PCB board builder, that help people turn hardware ideas into real prototypes without writing code.",
  "Alongside my work, I've built things with my brother, [Meer Estiyak](https://mmestiyak.com/). Together we made [Kommercly](/projects/kommercly/), a mobile-first store builder that lets Bangladeshi merchants set up an online shop and take orders through WhatsApp, and [KhamarVest](/projects/khamarvest/), a farm dashboard that keeps track of cattle, feed and supplies, and the money going in and out, all in one place.",
  "Outside of work, you'll usually find me gaming, out cycling, or walking around taking photos with my phone. I love exploring new places with no plan and noticing small things most people walk past: the light on a wet road, the smell of rain, the quiet moments in between. I capture a lot of those little moments.",
  "And when I have some free time, I design things for no reason at all. Customizing, tweaking, making something look just right. It's not for work or for anyone else, it just gives me a kind of peace.",
  "Above all, I'm a Muslim, and I'm always trying to become a better one, in my work, in how I treat people, and in everyday life.",
  "I made this site as my own little corner, a place for my work, my stories, and the small things I notice along the way.",
];
// Splits a paragraph into plain text and [text](url) links.
const parts = (paragraph) =>
  paragraph.split(/(\[[^\]]+\]\([^)]+\))/).map((piece) => {
    const link = /^\[([^\]]+)\]\(([^)]+)\)$/.exec(piece);
    return link ? { text: link[1], url: link[2] } : { text: piece };
  });
// A few things I love, shown with quiet "·" bullets.
// (Taken from my story above.)
const LOVES = [
  "Gaming",
  "Cycling",
  "Taking photos with my phone",
  "Exploring new places with no plan",
  "Noticing the small things most people walk past",
  "Designing things just for fun",
];
const EMAIL = "redfoxtahmid@gmail.com";

const description = "Meer Tahmid — a software engineer from Bangladesh, in my own words.";
---

<BaseLayout
  title="About"
  description={description}
  canonical="/about"
  og={{ title: "About — Meer Tahmid", description }}
>
  <main class="about">
    <div class="about-inner">
      <header class="about-header">
        <div class="about-intro">
          <p class="about-label">About</p>
          <h1 class="about-title">Hello, I&rsquo;m<br />Meer Tahmid.</h1>
          <p class="about-lead">
            I&rsquo;m a software engineer from Bangladesh. At{" "}
            <a href={WORK_NOW.url} target="_blank" rel="noopener noreferrer">{WORK_NOW.name}</a>, I
            work on browser-based CAD software, including 2D and 3D editors and a PCB board builder,
            that helps people turn hardware ideas into real prototypes without writing code. Before
            that, I was at{" "}
            <a href={WORK_BEFORE.url} target="_blank" rel="noopener noreferrer">{WORK_BEFORE.name}</a>,
            a 3D marketplace, where I built the platform&rsquo;s foundation from the ground up.
          </p>
        </div>

        <!-- Portrait: matte black and white, like the homepage. -->
        <figure class="about-photo">
          <img src="/me.png" alt="Portrait of Meer Tahmid" width="1088" height="1445" />
          <figcaption>Meer Tahmid · Bangladesh</figcaption>
        </figure>
      </header>

      <div class="about-grid">
        <div class="about-body">
          <section class="about-section">
            {STORY.map((paragraph) => (
              <p class="about-text">
                {parts(paragraph).map((part) =>
                  part.url ? (
                    <a
                      class="about-link"
                      href={part.url}
                      {...(part.url.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                    >{part.text}</a>
                  ) : (
                    part.text
                  ),
                )}
              </p>
            ))}
          </section>

          <section class="about-section">
            <h2 class="about-section-label">Things I love</h2>
            <ul class="about-list">
              {LOVES.map((item) => <li>{item}</li>)}
            </ul>
          </section>

          <section class="about-section">
            <h2 class="about-section-label">Around here</h2>
            <p class="about-text">
              If you want to know me a bit more, my{" "}
              <a class="about-link" href="/photobook">photobook</a> has the moments I've kept, and my{" "}
              <a class="about-link" href="/blogs">writing</a> has the stories.
            </p>
          </section>

          <section class="about-section">
            <h2 class="about-section-label">Say hello</h2>
            <p class="about-text">
              I'm always happy to hear from people. Tell me about a book, a place I should visit, or
              just say hi:{" "}
              <a class="about-link" href={`mailto:${EMAIL}`}>{EMAIL}</a>
            </p>
            <div class="about-actions">
              <a class="about-btn about-btn--primary" href={`mailto:${EMAIL}`}>Say hello</a>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  /* Same light theme as the rest of the site: Fraunces headings, Questrial
     text, small uppercase labels and thin lines between sections. */
  .about {
    background: var(--bg);
    padding: calc(100px + 56px) 0 7.5rem;
  }
  .about-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--container-pad);
  }

  /* ─── Header ─── */
  /* Intro on the left, portrait on the right. */
  .about-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
    gap: 4rem;
    align-items: end;
    padding-bottom: 3.5rem;
  }
  .about-intro {
    max-width: 720px;
  }
  .about-label {
    margin: 0 0 0.9rem;
    font-family: var(--font-label);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .about-title {
    margin: 0 0 1.25rem;
    font-family: var(--font-heading);
    font-size: 56px;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--text);
  }
  .about-lead {
    margin: 0;
    font-family: var(--font-text);
    font-size: var(--text-body);
    line-height: var(--text-body-lh); /* same as the story below */
    color: var(--text);
  }

  /* Workplace names: darker, with a thin underline (as on the homepage). */
  .about-lead a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--text) 35%, transparent);
    text-underline-offset: 5px;
    transition: text-decoration-color 0.2s ease;
  }
  .about-lead a:hover {
    text-decoration-color: var(--text);
  }

  /* ─── The story: one calm reading column under the line ─── */
  .about-grid {
    padding-top: 3.5rem;
    border-top: 1px solid var(--stroke);
  }
  .about-body {
    max-width: 720px;
  }
  .about-photo {
    margin: 0;
  }
  .about-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 10px;
    filter: grayscale(1) contrast(0.74);
  }
  .about-photo figcaption {
    margin-top: 0.85rem;
    font-family: var(--font-heading);
    font-size: 15px;
    font-style: italic;
    color: var(--muted);
  }

  /* ─── Sections ─── */
  .about-section + .about-section {
    margin-top: 3.25rem;
  }
  .about-section-label {
    margin: 0 0 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--stroke);
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .about-text {
    margin: 0 0 var(--text-gap);
    font-family: var(--font-text);
    font-size: var(--text-body);
    line-height: var(--text-body-lh);
    color: var(--text);
  }
  .about-text:last-child {
    margin-bottom: 0;
  }
  .about-link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  /* Quiet "·" bullets. */
  .about-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .about-list li {
    position: relative;
    padding-left: 1.1rem;
    font-family: var(--font-text);
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
    color: var(--text);
  }
  .about-list li + li {
    margin-top: 0.5rem;
  }
  .about-list li::before {
    content: "·";
    position: absolute;
    left: 0.15rem;
    color: var(--muted);
  }

  /* Say hello: a button like the hero (social links are in the footer). */
  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.75rem 0 1.5rem;
  }
  .about-btn {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 1.3rem;
    border: 1px solid var(--stroke);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--bg) 60%, white);
    color: var(--text);
    font-family: var(--font-text);
    font-size: 0.9rem;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      opacity 0.2s ease;
  }
  .about-btn:hover {
    border-color: var(--text);
  }
  .about-btn--primary {
    border-color: var(--text);
    background: var(--text);
    color: var(--bg);
  }
  .about-btn--primary:hover {
    opacity: 0.85;
  }

  /* ─── Smaller screens: photo first, then the intro ─── */
  @media (max-width: 860px) {
    .about-header {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .about-photo {
      order: -1;
      max-width: 260px;
    }
  }
  @media (max-width: 640px) {
    .about {
      padding: calc(64px + 2.5rem) 0 5rem;
    }
    .about-inner {
      padding: 0 1rem;
    }
    .about-title {
      font-size: 40px;
    }
  }
</style>
