---
import BaseLayout from "../layouts/BaseLayout.astro";
import { socialLinks } from "../data/portfolio";

// ─── Edit these to make the page yours ───
// The opening line under the title.
const LEAD = "Hi, I'm Meer. I'm from Bangladesh, and this is a little about me.";
// My story, one paragraph per item. Short and simple, in my own words.
const STORY = [
  "I grew up in Bangladesh. Rainy afternoons, strong tea and long talks with family and friends shaped who I am.",
  "I'm a slow-morning person. I like to start the day quietly, with a cup of tea and nowhere to rush to.",
  "I love walking around new places with no plan. I notice small things most people walk past — the light on a wet road, the smell of rain, steam rising from a cup of tea. I take a lot of photos of those little moments.",
  "I like old books, the kind you want to read twice. And I still think rain on a tin roof is the best sound there is.",
  "I made this site as my own little corner. It's where I keep my stories, my thoughts and the moments I don't want to forget.",
];
// A few things I love, shown with quiet "·" bullets.
const LOVES = [
  "Slow mornings and strong tea",
  "Walking new streets with no plan",
  "Taking photos of small moments",
  "Old books worth reading twice",
  "Rain on a tin roof",
];
const EMAIL = "redfoxtahmid@gmail.com";
const order = ["GitHub", "LinkedIn", "Instagram", "Facebook"];
const socials = [...socialLinks].sort((a, b) => order.indexOf(a.label) - order.indexOf(b.label));

const description = "A little about Meer Tahmid, in my own words.";
---

<BaseLayout
  title="About"
  description={description}
  canonical="/about"
  og={{ title: "About — Meer Tahmid", description }}
>
  <main class="about">
    <div class="about-inner">
      <header class="about-header">
        <p class="about-label">About</p>
        <h1 class="about-title">A little about me.</h1>
        <p class="about-lead">{LEAD}</p>
      </header>

      <div class="about-grid">
        <!-- Portrait: matte black and white, like the homepage. -->
        <figure class="about-photo">
          <img src="/me.png" alt="Portrait of Meer Tahmid" width="1088" height="1445" />
          <figcaption>Meer Tahmid · Bangladesh</figcaption>
        </figure>

        <div class="about-body">
          <section class="about-section">
            <h2 class="about-section-label">My story</h2>
            {STORY.map((paragraph) => <p class="about-text">{paragraph}</p>)}
          </section>

          <section class="about-section">
            <h2 class="about-section-label">Things I love</h2>
            <ul class="about-list">
              {LOVES.map((item) => <li>{item}</li>)}
            </ul>
          </section>

          <section class="about-section">
            <h2 class="about-section-label">Around here</h2>
            <p class="about-text">
              If you want to know me a bit more, my{" "}
              <a class="about-link" href="/photobook">photobook</a> has the moments I've kept, and my{" "}
              <a class="about-link" href="/blogs">writing</a> has the stories.
            </p>
          </section>

          <section class="about-section">
            <h2 class="about-section-label">Say hello</h2>
            <p class="about-text">
              I'm always happy to hear from people. Tell me about a book, a place I should visit, or
              just say hi:{" "}
              <a class="about-link" href={`mailto:${EMAIL}`}>{EMAIL}</a>
            </p>
            <div class="about-actions">
              <a class="about-btn about-btn--primary" href={`mailto:${EMAIL}`}>Say hello</a>
            </div>
            <ul class="about-socials">
              {socials.map((link) => (
                <li>
                  <a href={link.url} target="_blank" rel="noopener noreferrer">
                    {link.label} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  /* Same light theme as the rest of the site: Fraunces headings, Questrial
     text, small uppercase labels and thin lines between sections. */
  .about {
    background: var(--bg);
    padding: calc(100px + 56px) 0 7.5rem;
  }
  .about-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--container-pad);
  }

  /* ─── Header ─── */
  .about-header {
    max-width: 720px;
    padding-bottom: 3rem;
  }
  .about-label {
    margin: 0 0 0.9rem;
    font-family: var(--font-label);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .about-title {
    margin: 0 0 1.25rem;
    font-family: var(--font-heading);
    font-size: 56px;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--text);
  }
  .about-lead {
    margin: 0;
    font-family: var(--font-text);
    font-size: 21px;
    line-height: 34px;
    color: var(--text);
  }

  /* ─── Portrait left (stays in view), words right ─── */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
    gap: 4.5rem;
    align-items: start;
    padding-top: 3rem;
    border-top: 1px solid var(--stroke);
  }
  .about-photo {
    position: sticky;
    top: 130px;
    margin: 0;
  }
  .about-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 10px;
    filter: grayscale(1) contrast(0.74);
  }
  .about-photo figcaption {
    margin-top: 0.85rem;
    font-family: var(--font-heading);
    font-size: 15px;
    font-style: italic;
    color: var(--muted);
  }

  /* ─── Sections ─── */
  .about-section + .about-section {
    margin-top: 3.25rem;
  }
  .about-section-label {
    margin: 0 0 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--stroke);
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .about-text {
    margin: 0 0 1.25rem;
    font-family: var(--font-text);
    font-size: 20px;
    line-height: 34px;
    color: var(--text);
  }
  .about-text:last-child {
    margin-bottom: 0;
  }
  .about-link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  /* Quiet "·" bullets. */
  .about-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .about-list li {
    position: relative;
    padding-left: 1.1rem;
    font-family: var(--font-text);
    font-size: 17px;
    line-height: 28px;
    color: var(--text);
  }
  .about-list li + li {
    margin-top: 0.5rem;
  }
  .about-list li::before {
    content: "·";
    position: absolute;
    left: 0.15rem;
    color: var(--muted);
  }

  /* Say hello: buttons like the hero, socials in a row. */
  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.75rem 0 1.5rem;
  }
  .about-btn {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 1.3rem;
    border: 1px solid var(--stroke);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--bg) 60%, white);
    color: var(--text);
    font-family: var(--font-text);
    font-size: 0.9rem;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      opacity 0.2s ease;
  }
  .about-btn:hover {
    border-color: var(--text);
  }
  .about-btn--primary {
    border-color: var(--text);
    background: var(--text);
    color: var(--bg);
  }
  .about-btn--primary:hover {
    opacity: 0.85;
  }
  .about-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .about-socials a {
    font-family: var(--font-text);
    font-size: 15px;
    color: var(--text);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .about-socials a:hover {
    opacity: 0.6;
  }
  .about-socials span {
    font-size: 13px;
    color: var(--muted);
  }

  /* ─── Smaller screens: photo on top, then the words ─── */
  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .about-photo {
      position: static;
      max-width: 320px;
    }
  }
  @media (max-width: 640px) {
    .about {
      padding: calc(64px + 2.5rem) 0 5rem;
    }
    .about-inner {
      padding: 0 1rem;
    }
    .about-title {
      font-size: 40px;
    }
    .about-lead {
      font-size: 18px;
      line-height: 30px;
    }
    .about-text {
      font-size: 18px;
      line-height: 30px;
    }
  }
</style>
