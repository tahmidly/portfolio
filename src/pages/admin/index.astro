---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminPage from "../../views/AdminPage.jsx";
import { getAllPosts } from "../../lib/posts";

// Signed-out requests are redirected to /admin/login by src/middleware.js.
let posts = [];
let loadError = null;
try {
  posts = await getAllPosts();
} catch (error) {
  console.error("[admin] failed to load posts", error);
  loadError = "Couldn’t load posts from the database.";
}
---

<BaseLayout title="Studio" noindex variant="admin">
  <AdminPage client:only="react" initialPosts={posts} loadError={loadError} />
</BaseLayout>
