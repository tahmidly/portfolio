---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LoginForm from "../../components/LoginForm.jsx";
import "../../views/AdminPage.css";

if (Astro.locals.isAdmin) return Astro.redirect("/admin");

const error = Astro.url.searchParams.get("error") ?? undefined;
---

<BaseLayout title="Sign in" noindex variant="admin">
  <main class="admin-login">
    <LoginForm client:load error={error} />
  </main>
</BaseLayout>
